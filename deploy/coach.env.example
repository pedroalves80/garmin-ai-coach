# Copy to docker-home/configs/garmin-ai-coach/coach.env with mode 0600.
GARMIN_COACH_IMAGE=garmin-ai-coach:4196ed4-arm64
# Override only the web image for static/UI updates; keep the worker unchanged.
GARMIN_COACH_WEB_IMAGE=garmin-ai-coach:f4a1707-arm64
GARMIN_COACH_BIND_IP=127.0.0.1
GARMIN_PERSONAL_API_KEY=
GARMIN_AUTO_SYNC=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SYNC_SECRET=
APP_ALLOWED_ORIGINS=https://coach.home.arpa,http://127.0.0.1:3100
DATABASE_PATH=/app/data/coach.db
