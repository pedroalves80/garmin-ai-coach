{
  "name": "garmin-ai-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run build:worker && node scripts/prepare-standalone.mjs",
    "build:worker": "tsc -p tsconfig.worker.json",
    "worker": "node --env-file-if-exists=.env build/worker/server/garmin/worker.js",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate-cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests scripts package.json",
    "format:check": "prettier --check src tests scripts package.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "openai": "^7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
