# Server-only secrets. Never expose these through NEXT_PUBLIC_* variables.
GARMIN_PERSONAL_API_KEY=
# Automatic startup/three-hour sync. False keeps manual syncing available.
GARMIN_AUTO_SYNC=true
# Optional, only for non-browser automation. Never enter it in the app.
SYNC_SECRET=
# Optional custom private origins, comma-separated (normal LAN IPs/.local work automatically).
APP_ALLOWED_ORIGINS=
DATABASE_PATH=./data/coach.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
